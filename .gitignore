# Out-of-tree build directories: app/build_win.bat and the test suite both use build/.
build/

# Visual Studio project files CMake generates beside the sources when configured in place.
/app/*.vcxproj
/app/*.vcxproj.filters
/app/*.vcxproj.user
/app/*.sln
/app/TestVHACD.exe
/app/CMakeCache.txt
/app/CMakeFiles/
/app/cmake_install.cmake
/app/Makefile

# TestVHACD writes its results into the working directory: decomp.* always, one file per hull under -o.
/decomp.obj
/decomp.mtl
/decomp.stl
/decomp.usda
/*_decompose.stl
/*[0-9][0-9][0-9].obj
/*[0-9][0-9][0-9].stl
/*[0-9][0-9][0-9].usda

/*.bak
